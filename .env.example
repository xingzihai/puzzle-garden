# v0.3beta 只有一套环境变量前缀：PG_。只在入口由 @pg/config（packages/config/src/config.ts）读取一次。
# 复制为 .env 后填写；.env 不入库。

# OpenAI 兼容接口
PG_LLM_BASE_URL=https://example.invalid/v1
PG_LLM_API_KEY=
PG_LLM_MODEL=deepseek-flash
# deepseek-flash capability baseline (official DeepSeek docs; see docs/MODEL-CAPABILITIES.md):
#   context window: up to 1,000,000 tokens total (shared by input + output);
#   official docs publish only "1M", the exact 1,000,000 / 1,048,576 integer is unconfirmed
#   max output per API completion: up to 384,000 (393,216) tokens
# The PG_* limits below are project budgets, not model ceilings.
PG_LLM_TIMEOUT_MS=600000

# 单次 run 花费上限（人民币）。构建 agent 取它与 --max-cny（≤ 3.5）的较小值；0 不放宽 --max-cny
PG_MAX_RUN_COST_CNY=3.5

# 真实模型调用的第二道确认：只有设为 1 且命令行带 --live 才发请求（AGENT-SPEC §11）
PG_LIVE_CONFIRM=
