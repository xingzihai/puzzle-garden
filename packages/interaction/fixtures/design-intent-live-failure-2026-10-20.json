  "decisions": [
    {
      "id": "dec-footprint",
      "topic": "主体与模数",
      "choice": "主体按 8×6 整格布置，墙厚 1 格，主厅净 6×4 格。",
      "rationale": "满足约 8×6 米主体与整格取整要求，同时为 6 座茶桌留出净空。",
      "requirementIds": ["req-footprint", "con-footprint", "con-grid"]
    },
    {
      "id": "dec-service-north",
      "topic": "服务带靠北",
      "choice": "柜台与储物柜全部靠北墙服务带，南侧留给座位与南向开口。",
      "rationale": "避免服务空间遮挡南向稻田视线与采光。",
      "requirementIds": ["req-counter", "req-storage", "req-south-view", "cap-furniture-grid"]
    },
    {
      "id": "dec-seating",
      "topic": "6 座配置",
      "choice": "3×1 茶桌配南北两条 3 座长凳，共 6 座，主视线朝南。",
      "rationale": "以整格近似满足 6 人同时饮茶，并保持交流紧凑。",
      "requirementIds": ["req-seat-6", "cap-furniture-grid"]
    },
    {
      "id": "dec-south-open",
      "topic": "南向半开敞",
      "choice": "南墙设 6 格宽落地大开口，洞口两侧各留 1 格墙垛，外侧接檐下平台。",
      "rationale": "最大化南向稻田景观与室内外过渡，同时保留基本围护。",
      "requirementIds": ["req-south-view", "req-eave-porch"]
    },
    {
      "id": "dec-roof",
      "topic": "深瓦双坡与出檐",
      "choice": "双坡深瓦屋面，屋脊东西向，南坡出檐 2 格，南北排水。",
      "rationale": "形成明确大出檐深瓦外观，并为南向开口遮阳挡雨。",
      "requirementIds": ["req-dark-tile", "req-south-view", "req-eave-porch"]
    },
    {
      "id": "dec-material",
      "topic": "木石深瓦",
      "choice": "木构架与木装修为主，石材用于台基、勒脚与局部铺地，屋面用深色瓦。",
      "rationale": "落实用户木石深瓦材料偏好，并控制石材用量以兼顾造价。",
      "requirementIds": ["req-wood-stone", "req-dark-tile", "con-material"]
    },
    {
      "id": "dec-budget",
      "topic": "造价控制",
      "choice": "石材限台基、勒脚与铺地，取消异形构件与装饰性细部，采用简单坡瓦屋面。",
      "rationale": "在木石深瓦前提下用材料用量与构造简化控制造价。",
      "requirementIds": ["req-budget", "con-budget"]
    },
    {
      "id": "dec-entry",
      "topic": "北侧入口与到达",
      "choice": "北墙中部设 2 格宽双开门，北侧入口前场留 1–2 级台阶过渡。",
      "rationale": "默认北侧临村道，形成便捷到达并解决台基防潮抬高。",
      "requirementIds": ["req-entry-step", "req-village-entrance"]
    },
    {
      "id": "dec-interior",
      "topic": "室内交付深度",
      "choice": "室内配齐固定柜台、储物高柜、茶桌、南北长凳、吊灯与桌面绿植。",
      "rationale": "满足完整室内要求；受体素模数限制，家具尺度为整格近似。",
      "requirementIds": ["req-interior-complete", "cap-interior-view", "cap-furniture-grid"]
    },
    {
      "id": "dec-storage-cabinet",
      "topic": "储物形式",
      "choice": "储物以 2 格宽高柜嵌入北墙服务带，不设独立储物间。",
      "rationale": "小体量下独立储物间会挤压南向景观与主厅净空，故用固定高柜满足可关闭储物。",
      "requirementIds": ["req-storage", "req-south-view", "cap-furniture-grid"]
    },
    {
      "id": "dec-structure-note",
      "topic": "结构限制",
      "choice": "木构跨度与出檐只作经验控制，不做材料力学与抗震计算。",
      "rationale": "能力卡明确不支持结构计算，需专业方复核。",
      "requirementIds": ["con-no-structure-calc", "cap-structure"]
    }
  ],
