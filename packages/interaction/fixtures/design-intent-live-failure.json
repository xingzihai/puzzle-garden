    {
      "id": "d1",
      "topic": "建筑规模",
      "choice": "单层茶亭，外轮廓 8×6 米，占地约 48 m²。",
      "rationale": "用户明确给出约 8×6 米与茶亭功能，规模按原话固定。",
      "source": "user",
      "requirementIds": ["req-tea-pavilion-size", "con-tea-footprint"],
      "notes": null
    },
    {
      "id": "d2",
      "topic": "主朝向与景观面",
      "choice": "南立面为主景观界面，整跨开敞，中柱分两跨，尽量减少竖向遮挡。",
      "rationale": "用户要求南向看稻田，强偏好南向通透；两跨柱廊在 8 米面宽内兼顾结构与视野。",
      "source": "user",
      "requirementIds": ["req-tea-pavilion-south-view", "pref-tea-south-open"],
      "notes": null
    },
    {
      "id": "d3",
      "topic": "材料与屋面调性",
      "choice": "石台基 + 石砌北墙与山下段 + 深色木柱梁门窗 + 深瓦双坡屋面。",
      "rationale": "用户原话“木石深瓦”直接指定材料与屋面方向；石材集中在台基与背墙以控制造价。",
      "source": "user",
      "requirementIds": [
        "req-tea-timber-stone-material",
        "req-tea-dark-tile-roof",
        "con-tea-material-palette",
        "pref-tea-stone-base",
        "pref-tea-timber-tone"
      ],
      "notes": null
    },
    {
      "id": "d4",
      "topic": "座位组织",
      "choice": "一张固定长桌配南北两排长凳，主座 6 人，桌端加一短凳，柜台前另设 2 个快速座。",
      "rationale": "取歧义项建议默认值：固定长桌配两侧坐凳在 48 m² 内最易同时满足 6 座与南向观景，且占地小、定制量低。",
      "source": "agent",
      "requirementIds": ["req-tea-seat-six", "req-tea-fixed-furniture", "con-tea-access-clearance"],
      "notes": null
    },
    {
      "id": "d5",
      "topic": "柜台与储物位置",
      "choice": "柜台贴北墙，台面外挑 1 格；储物柜在东北角内嵌，柜门朝西开向主厅。",
      "rationale": "服务功能靠背面，不遮挡南向景观面；储物靠近柜台且避开视线界面。",
      "source": "user",
      "requirementIds": ["req-tea-counter", "req-tea-storage"],
      "notes": null
    },
    {
      "id": "d6",
      "topic": "柜台服务深度",
      "choice": "本期柜台仅台面 + 柜体储物，热水由移动设备提供，不做给排水与用电承诺。",
      "rationale": "取歧义项建议默认值：控制造价与系统复杂度，且红石/动态与设备系统不在能力范围。",
      "source": "agent",
      "requirementIds": ["req-tea-counter", "req-tea-budget-restraint", "req-tea-no-redstone-electrical"],
      "notes": null
    },
    {
      "id": "d7",
      "topic": "入口位置",
      "choice": "主入口设在北侧偏西，双开木门 2 格宽，门外 2 级石台阶接北侧铺装。",
      "rationale": "由南向看稻田推断入口不宜开在南面，使南立面保持连续景观界面；北面迎村路来向，形成门户识别。",
      "source": "agent",
      "requirementIds": ["req-tea-entrance-side", "req-tea-village-gate-location", "req-tea-plaza-paving"],
      "notes": null
    },
    {
      "id": "d8",
      "topic": "建筑层数与屋面",
      "choice": "单层，净高 3.6 米；南北向双坡深瓦屋面，屋脊平行于东西向，檐口出挑 2 格。",
      "rationale": "8×6 米小亭按单层处理；单一屋脊避免转角特殊瓦件，南侧深挑形成观景檐廊。",
      "source": "agent",
      "requirementIds": [
