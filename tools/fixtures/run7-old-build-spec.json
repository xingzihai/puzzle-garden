  "musts": [
    {
      "id": "req-teahouse-program",
      "text": "在村口溪边新建一座茶亭，作为村口公共小建筑供歇脚饮茶使用。",
      "source": "requirement"
    },
    {
      "id": "req-outer-10x8",
      "text": "建筑外轮廓为 10m×8m 的矩形体量，不得超出。",
      "source": "requirement"
    },
    {
      "id": "req-single-storey",
      "text": "整栋为单层，无楼层、无楼梯、无地下空间。",
      "source": "requirement"
    },
    {
      "id": "req-no-mezzanine",
      "text": "不加二层，也不做夹层（不得以夹层方式增加使用面积）。",
      "source": "requirement"
    },
    {
      "id": "req-single-hall",
      "text": "整栋只有一间完整主厅，就座、饮茶、备茶、观景等全部功能集中在同一空间内。",
      "source": "requirement"
    },
    {
      "id": "req-no-partitions",
      "text": "不设玄关、门厅、走廊、卫生间、储藏间、操作间、设备间、厨房或任何隔间，室内不出现任何分隔墙。",
      "source": "requirement"
    },
    {
      "id": "req-interior-8x6",
      "text": "室内净尺寸 8m×6m，净面积 48㎡。",
      "source": "requirement"
    },
    {
      "id": "req-wall-thick-1m",
      "text": "外墙厚度 1m，形成较深的门窗洞口，但不因此产生门厅或隔间。",
      "source": "requirement"
    },
    {
      "id": "req-door-north-west",
      "text": "北墙西段直接开门，门洞净宽 2m，直接连通室外北侧村道，中间不设玄关或门厅。",
      "source": "requirement"
    },
    {
      "id": "req-door-clear-1m",
      "text": "门内侧保留 1m 宽的空地（门内进深 1m 的净空带），该处不摆放家具。",
      "source": "requirement"
    },
    {
      "id": "req-window-south-4m",
      "text": "南墙只做一条 4m 宽的大窗用于观看南侧溪流，南墙无其他洞口。",
      "source": "requirement"
    },
    {
      "id": "req-window-dim",
      "text": "窗台高 1m、窗高 2m，洞口顶位于室内地面以上 3m。",
      "source": "requirement"
    },
    {
      "id": "req-no-glass-door",
      "text": "南墙不做落地门或落地窗，室内外进出仅通过北门。",
      "source": "requirement"
    },
    {
      "id": "req-no-outdoor-zone",
      "text": "不做檐下平台、露台、台阶或任何室外分区，场地不新设可停留的室外地面（无铺装平台、无檐廊、无庭院、无入口铺装带）。",
      "source": "requirement"
    },
    {
      "id": "req-no-steps",
      "text": "入口不设台阶、不设坡道；室内地面与室外地面齐平，经门洞直接连通村道。",
      "source": "requirement"
    },
    {
      "id": "req-long-table",
      "text": "主厅东侧靠东墙设一张 4m 长、2m 宽的长桌（长边沿东西向）。",
      "source": "requirement"
    },
    {
      "id": "req-bench-north",
      "text": "长桌北侧设一条 4m 长、1m 宽的长凳，其西端从门洞东侧开始，不侵占门内 1m 净空。",
      "source": "requirement"
    },
    {
      "id": "req-bench-south",
      "text": "长桌南侧设一条 4m 长、1m 宽的长凳，与北凳相对布置。",
      "source": "requirement"
    },
    {
      "id": "req-seats-10",
      "text": "就座共 10 座，南北两条长凳各 5 座（5+5）。",
      "source": "requirement"
    },
    {
      "id": "req-counter",
      "text": "西墙中段设一张 2m 长、1m 深的柜台，作为主厅内的固定家具台面，不做单独隔间或操作间，也不延伸出备茶区。",
      "source": "requirement"
    },
    {
      "id": "req-counter-no-service",
      "text": "柜台不设水槽、热水或其他备茶设备，不预留给排水与电源点位，仅为固定家具台面。",
      "source": "requirement"
    },
    {
      "id": "req-stone-base",
      "text": "建筑坐于石基座上；石基座仅作墙下垫层与防潮层，不外挑成平台、不抬升室内地坪到需要踏步的高度。",
      "source": "requirement"
    },
    {
      "id": "req-wood-wall-column",
      "text": "外墙与柱为木材（木墙木柱）。",
      "source": "requirement"
    },
    {
      "id": "req-gable-tile-roof",
      "text": "屋面为双坡形式，覆深色瓦。",
      "source": "requirement"
    },
    {
      "id": "req-eave-only",
      "text": "屋面只做出檐，不做檐下平台或檐廊；出檐下方不设铺装与可停留地面。",
      "source": "requirement"
    },
    {
      "id": "req-block-budget",
      "text": "整体方块用量不超过 20000 方块；按 1 格≈1m 估算，10m×8m×约 6m 的主体体量远低于该上限。",
      "source": "requirement"
    },
    {
      "id": "req-no-sign-ticket-frame",
      "text": "不设招牌、售票窗口或装饰性构架。",
      "source": "requirement"
    },
    {
      "id": "req-site-stream-south",
      "text": "溪流位于场地南侧，是建筑的主要景观方向。",
      "source": "requirement"
    },
    {
      "id": "req-site-road-north",
      "text": "村道位于场地北侧，建筑位于村口溪边。",
      "source": "requirement"
    },
    {
      "id": "req-entrance-from-north",
      "text": "人流由北侧村道直接进入北墙门洞，入口朝北；入口处地面齐平、无踏步。",
      "source": "requirement"
    },
    {
      "id": "req-view-frame",
      "text": "南墙 4m 大窗作为溪景取景框，是主厅的视觉中心，室内布置需让主要座席朝窗。",
      "source": "requirement"
    },
    {
      "id": "constraint-con-outer-10x8",
