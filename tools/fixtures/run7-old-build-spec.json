      "source": "constraint"
    },
    {
      "id": "constraint-con-single-storey",
      "text": "单层建筑，无二层、无夹层、无楼梯、无地下层。",
      "source": "constraint"
    },
    {
      "id": "constraint-con-interior-clear",
      "text": "室内净尺寸 8m×6m（48㎡）。",
      "source": "constraint"
    },
    {
      "id": "constraint-con-wall-1m",
      "text": "外墙厚 1m。",
      "source": "constraint"
    },
    {
      "id": "constraint-con-door-2m",
      "text": "北墙西段门洞净宽 2m。",
      "source": "constraint"
